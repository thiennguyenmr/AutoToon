# =============================================================
# PostgreSQL
# =============================================================
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change_me
POSTGRES_DB=n8n

# =============================================================
# n8n
# =============================================================
N8N_RUNNERS_AUTH_TOKEN=change_me

# Fixed encryption key — keeps the same key across container recreates so API keys stay valid.
# Generate once with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change_me

# API key to allow OpenClaw to call the n8n REST API (create at: n8n UI -> Settings -> API)
N8N_API_KEY=change_me

# =============================================================
# vLLM / HuggingFace
# =============================================================
# Get token at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================
# OpenClaw
# =============================================================
OPENCLAW_GATEWAY_TOKEN=change_me

# Port mapping (host ports remapped to 278xx for abc project)
OPENCLAW_GATEWAY_PORT=27889
OPENCLAW_BRIDGE_PORT=27890

# =============================================================
# MinIO
# =============================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me
