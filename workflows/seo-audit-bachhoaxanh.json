    {
      "parameters": {
        "jsCode": "// Gather all analysis results\nconst items = $input.all();\n\n// Extract analyses from merged items\nlet titleAnalysis = '';\nlet descriptionAnalysis = '';\nlet contentAnalysis = '';\nlet densityAnalysis = '';\nlet altsAnalysis = '';\nlet robotsTxt = '';\nlet hasSitemap = false;\nlet pageSpeedData = null;\nlet hasCanonical = false;\n\nfor (const item of items) {\n  const d = item.json;\n  if (d.text && !titleAnalysis) titleAnalysis = d.text;\n  else if (d.text && !descriptionAnalysis) descriptionAnalysis = d.text;\n  else if (d.text && !contentAnalysis) contentAnalysis = d.text;\n  else if (d.text && !densityAnalysis) densityAnalysis = d.text;\n  else if (d.text && !altsAnalysis) altsAnalysis = d.text;\n  \n  if (d.robotsTxt) robotsTxt = d.robotsTxt;\n  if (d.hasSitemap !== undefined) hasSitemap = d.hasSitemap;\n  if (d.hasCanonical !== undefined) hasCanonical = d.hasCanonical;\n  if (d.lighthouseResult) pageSpeedData = d;\n}\n\n// Extract PageSpeed scores\nlet performanceScore = 'N/A';\nlet seoScore = 'N/A';\nlet accessibilityScore = 'N/A';\nlet bestPracticesScore = 'N/A';\n\nif (pageSpeedData && pageSpeedData.lighthouseResult) {\n  const categories = pageSpeedData.lighthouseResult.categories;\n  performanceScore = categories.performance ? Math.round(categories.performance.score * 100) : 'N/A';\n  seoScore = categories.seo ? Math.round(categories.seo.score * 100) : 'N/A';\n  accessibilityScore = categories.accessibility ? Math.round(categories.accessibility.score * 100) : 'N/A';\n  bestPracticesScore = categories['best-practices'] ? Math.round(categories['best-practices'].score * 100) : 'N/A';\n}\n\nreturn [{\n  json: {\n    titleAnalysis,\n    descriptionAnalysis,\n    contentAnalysis,\n    densityAnalysis,\n    altsAnalysis,\n    robotsTxt: robotsTxt ? 'Found' : 'Not Found',\n    hasSitemap,\n    hasCanonical,\n    performanceScore,\n    seoScore,\n    accessibilityScore,\n    bestPracticesScore,\n    url: $('Webhook').item.json.url || 'https://www.bachhoaxanh.com',\n    analyzedAt: new Date().toLocaleString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh' })\n  }\n}];"
      },
      "id": "fn-report",
      "name": "Functions to report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1632,
        736
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst html = `<!DOCTYPE html>\n<html lang=\"vi\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>SEO Audit Report - Bach Hoa Xanh</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #f5f7fa; color: #333; line-height: 1.6; }\n    .container { max-width: 900px; margin: 0 auto; padding: 20px; }\n    .header { background: linear-gradient(135deg, #1a73e8, #0d47a1); color: white; padding: 30px; border-radius: 12px; margin-bottom: 24px; text-align: center; }\n    .header h1 { font-size: 28px; margin-bottom: 8px; }\n    .header p { opacity: 0.9; font-size: 14px; }\n    .scores-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px; }\n    .score-card { background: white; border-radius: 12px; padding: 20px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }\n    .score-card .score { font-size: 36px; font-weight: 700; margin: 8px 0; }\n    .score-card .label { font-size: 13px; color: #666; text-transform: uppercase; letter-spacing: 0.5px; }\n    .score-good { color: #0cce6b; }\n    .score-avg { color: #ffa400; }\n    .score-bad { color: #ff4e42; }\n    .section { background: white; border-radius: 12px; padding: 24px; margin-bottom: 16px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }\n    .section h2 { font-size: 18px; color: #1a73e8; margin-bottom: 12px; padding-bottom: 8px; border-bottom: 2px solid #e8f0fe; }\n    .section pre { white-space: pre-wrap; word-wrap: break-word; font-size: 14px; background: #f8f9fa; padding: 16px; border-radius: 8px; }\n    .check-item { display: flex; align-items: center; padding: 8px 0; border-bottom: 1px solid #f0f0f0; }\n    .check-item:last-child { border-bottom: none; }\n    .check-pass { color: #0cce6b; margin-right: 8px; font-size: 18px; }\n    .check-fail { color: #ff4e42; margin-right: 8px; font-size: 18px; }\n    .footer { text-align: center; padding: 20px; color: #999; font-size: 12px; }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"header\">\n      <h1>&#x1f50d; SEO Audit Report</h1>\n      <p><strong>URL:</strong> ${data.url}</p>\n      <p><strong>Analyzed:</strong> ${data.analyzedAt}</p>\n    </div>\n\n    <div class=\"scores-grid\">\n      <div class=\"score-card\">\n        <div class=\"label\">Performance</div>\n        <div class=\"score ${Number(data.performanceScore) >= 90 ? 'score-good' : Number(data.performanceScore) >= 50 ? 'score-avg' : 'score-bad'}\">${data.performanceScore}</div>\n      </div>\n      <div class=\"score-card\">\n        <div class=\"label\">SEO</div>\n        <div class=\"score ${Number(data.seoScore) >= 90 ? 'score-good' : Number(data.seoScore) >= 50 ? 'score-avg' : 'score-bad'}\">${data.seoScore}</div>\n      </div>\n      <div class=\"score-card\">\n        <div class=\"label\">Accessibility</div>\n        <div class=\"score ${Number(data.accessibilityScore) >= 90 ? 'score-good' : Number(data.accessibilityScore) >= 50 ? 'score-avg' : 'score-bad'}\">${data.accessibilityScore}</div>\n      </div>\n      <div class=\"score-card\">\n        <div class=\"label\">Best Practices</div>\n        <div class=\"score ${Number(data.bestPracticesScore) >= 90 ? 'score-good' : Number(data.bestPracticesScore) >= 50 ? 'score-avg' : 'score-bad'}\">${data.bestPracticesScore}</div>\n      </div>\n    </div>\n\n    <div class=\"section\">\n      <h2>&#x1f3f7;&#xfe0f; Title Analysis</h2>\n      <pre>${data.titleAnalysis}</pre>\n    </div>\n\n    <div class=\"section\">\n      <h2>&#x1f4dd; Description Analysis</h2>\n      <pre>${data.descriptionAnalysis}</pre>\n    </div>\n\n    <div class=\"section\">\n      <h2>&#x1f4c4; Content Analysis</h2>\n      <pre>${data.contentAnalysis}</pre>\n    </div>\n\n    <div class=\"section\">\n      <h2>&#x1f50e; Keyword Density Analysis</h2>\n      <pre>${data.densityAnalysis}</pre>\n    </div>\n\n    <div class=\"section\">\n      <h2>&#x1f5bc;&#xfe0f; Image Alt Analysis</h2>\n      <pre>${data.altsAnalysis}</pre>\n    </div>\n\n    <div class=\"section\">\n      <h2>&#x2699;&#xfe0f; Technical SEO Checks</h2>\n      <div class=\"check-item\">\n        <span class=\"${data.robotsTxt === 'Found' ? 'check-pass' : 'check-fail'}\">${data.robotsTxt === 'Found' ? '&#x2705;' : '&#x274c;'}</span>\n        <span>Robots.txt: ${data.robotsTxt}</span>\n      </div>\n      <div class=\"check-item\">\n        <span class=\"${data.hasSitemap ? 'check-pass' : 'check-fail'}\">${data.hasSitemap ? '&#x2705;' : '&#x274c;'}</span>\n        <span>Sitemap.xml: ${data.hasSitemap ? 'Found' : 'Not Found'}</span>\n      </div>\n      <div class=\"check-item\">\n        <span class=\"${data.hasCanonical ? 'check-pass' : 'check-fail'}\">${data.hasCanonical ? '&#x2705;' : '&#x274c;'}</span>\n        <span>Canonical Tag: ${data.hasCanonical ? 'Present' : 'Missing'}</span>\n      </div>\n    </div>\n\n    <div class=\"footer\">\n      <p>Generated by SEO Audit Workflow - Bach Hoa Xanh | Powered by n8n + DeepSeek</p>\n    </div>\n  </div>\n</body>\n</html>`;\n\nreturn [{ json: { html, ...data } }];"
      },
